---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <img class="site-footer__branch" src="/img/ornament-branch.svg" alt="" width="900" height="120" aria-hidden="true" />

    <div class="site-footer__top">
      <div>
        <h2>Under the Hazel Tree</h2>
        <p class="site-footer__blurb">
          A place for poems, stories and quiet reflections — written slowly, and best read the same way.
        </p>
      </div>

      <div>
        <h2>Read</h2>
        <ul>
          <li><a href="/poems/">Poems</a></li>
          <li><a href="/stories/">Stories</a></li>
          <li><a href="/journal/">Journal</a></li>
          <li><a href="/about/">About</a></li>
        </ul>
      </div>

      <div>
        <h2>Follow</h2>
        <ul>
          <li><a href="/rss.xml">RSS feed</a></li>
          <li><a href="/wander">Take me somewhere</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {year} Under the Hazel Tree. All words the author's own.</p>
      <p>Nine hazels leaned above the well.</p>
    </div>
  </div>
</footer>
